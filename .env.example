# Copy to .env and change for anything beyond local development.
POSTGRES_USER=medflow
POSTGRES_PASSWORD=medflow
POSTGRES_DB=medflow

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# true only when served over HTTPS
COOKIE_SECURE=false

# Seed the fictional demo hospital on first start
SEED_DEMO=true

# Train demand-forecasting models on start if the hospital has none (V2)
TRAIN_ON_START=true

# V6 knowledge graph (Neo4j). Change before exposing anything; minimum 8 characters.
NEO4J_PASSWORD=change-me-neo4j
# neo4j (default) | falkordb | disabled — "disabled" runs MedFlow without the Knowledge graph page
GRAPH_BACKEND=neo4j

# V7 AI assistant. Default "none" = deterministic planner: no LLM, no key, nothing leaves the server.
# Optional: openai_compatible (e.g. a local Ollama / llama.cpp / vLLM server) or anthropic. Never commit a real key.
ASSISTANT_PROVIDER=none
# ASSISTANT_BASE_URL=http://host.docker.internal:11434/v1
# ASSISTANT_MODEL=
# ASSISTANT_API_KEY=

# V9 integrations. Pepper for hashing inbound API keys (generate like JWT_SECRET; never commit a real one).
# INTEGRATION_KEY_PEPPER=
# Hosts a rest_pull source may call (JSON list, set by the operator), e.g. ["erp.myhospital.example"]
# INTEGRATION_ALLOWED_HOSTS=[]
# Local reference ERP simulator: SIMULATED data for the demo hospitals only (never real hospitals). The server default is
# off; the demo turns it on. Change the token before exposing anything.
REFERENCE_ERP_ENABLED=true
REFERENCE_ERP_TOKEN=change-me-reference-erp
