# Used when running the backend outside Docker (uvicorn app.main:app --reload)
DATABASE_URL=postgresql+psycopg://medflow:medflow@localhost:5432/medflow
JWT_SECRET=change-me
COOKIE_SECURE=false

# V9: local reference ERP simulator (SIMULATED data, demo hospitals only) — off unless enabled. Change the token.
REFERENCE_ERP_ENABLED=true
REFERENCE_ERP_TOKEN=change-me-reference-erp
